//@version=6
indicator("Phase59B Canonical Live", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=100)

// =============================================================================
// PHASE59B — Frozen D(E) → P4 → H1 → M1 automatic indicator
// Layer A: fully automatic signals (reference-free)
// Layer B: parity debug markers (visual only — NEVER affects Layer A)
// Primary chart: 1M NQ | ATR = SMA(14) of range — NOT ta.atr()
// Signal on closed bar T → canonical ENTRY at open T+1
// Phase58 internal mgmt: 0.75 ATR (blocks new signals)
// Canonical M1 mgmt: 1.0 ATR stop, 2.5R target, 60 bar max hold
// =============================================================================

TZ_WARN = timeframe.in_seconds() != 60
WARMUP  = 100

// ── Display ──────────────────────────────────────────────────────────────────
grpDisp = "Display"
showTake      = input.bool(true,  "Show TAKE", group=grpDisp)
showEntry     = input.bool(true,  "Show ENTRY", group=grpDisp)
showStopTgt   = input.bool(true,  "Show stop/target", group=grpDisp)
showExits     = input.bool(true,  "Show exits", group=grpDisp)
showWait      = input.bool(false, "Show WAIT", group=grpDisp)
showPass      = input.bool(false, "Show PASS", group=grpDisp)
showP4Abst    = input.bool(false, "Show P4 abstains", group=grpDisp)
showH1Abst    = input.bool(false, "Show H1 abstains", group=grpDisp)
showHTF       = input.bool(false, "Show HTF context table", group=grpDisp)
showDebug     = input.bool(false, "Show diagnostic table", group=grpDisp)
showReason    = input.bool(false, "Show reason codes", group=grpDisp)
showExtDiag   = input.bool(false, "Show Phase58K extension diagnostic", group=grpDisp)

// ── Layer B: parity debug (visual only) ──────────────────────────────────────
grpPar = "Parity debug (visual only — NOT used for signals)"
debugParityMarkers = input.bool(false, "Debug historical parity markers", group=grpPar)
refEntryUnixMs     = input.time(1787769660000, "Reference entry unix ms", group=grpPar)
refDirection       = input.string("LONG", "Reference direction", options=["LONG", "SHORT"], group=grpPar)
refEntryUnixMs2    = input.time(1787905860000, "Ref entry unix ms #2", group=grpPar)
refDirection2      = input.string("LONG", "Ref direction #2", options=["LONG", "SHORT"], group=grpPar)
refEntryUnixMs3    = input.time(1787911140000, "Ref entry unix ms #3", group=grpPar)
refDirection3      = input.string("SHORT", "Ref direction #3", options=["LONG", "SHORT"], group=grpPar)

// ── Frozen parameters ────────────────────────────────────────────────────────
grpCore = "Frozen parameters"
structGap          = input.int(30, "Structural gap (1M bars)", minval=5, group=grpCore)
takeThreshold      = input.int(4, "Take threshold (variant E)", minval=1, group=grpCore)
armedMinScore      = input.int(2, "Armed min score", minval=1, group=grpCore)
armedTimeoutBars   = input.int(15, "Armed timeout bars", minval=5, group=grpCore)
swingPeriod        = input.int(5, "Swing period", minval=2, group=grpCore)
m1StopAtr          = input.float(1.0, "M1 stop ATR", group=grpCore)
p58StopAtr         = input.float(0.75, "Phase58 internal stop ATR", group=grpCore)
targetR            = input.float(2.5, "M1 target R", group=grpCore)
maxHoldBars        = input.int(60, "Max hold bars", minval=1, group=grpCore)
bodyThreshATR      = input.float(0.3, "Body threshold ATR", group=grpCore)
maxChaseATR        = input.float(1.5, "Max chase ATR", group=grpCore)
cooldownBars       = input.int(3, "Cooldown bars", group=grpCore)
maxWaitBars        = input.int(2, "Max wait bars (variant E)", minval=0, group=grpCore)
decelLookback      = input.int(3, "Deceleration lookback", minval=2, group=grpCore)
microShiftBars     = input.int(2, "Micro shift bars", minval=1, group=grpCore)
wickRejectionPct   = input.float(0.5, "Wick rejection pct", group=grpCore)
ctPullback         = input.float(0.5, "Countertrend pullback ratio", group=grpCore)
ctReversal         = input.float(0.85, "Countertrend reversal ratio", group=grpCore)
progressLb1m       = input.int(8, "Progress lookback 1M", minval=3, group=grpCore)
progressLb5m       = input.int(5, "Progress lookback 5M", minval=2, group=grpCore)
progressLb15m      = input.int(4, "Progress lookback 15M", minval=2, group=grpCore)
strongProgressAtr  = input.float(1.0, "Strong progress ATR", group=grpCore)
weakProgressAtr    = input.float(0.3, "Weak progress ATR", group=grpCore)

// =============================================================================
// ATR — Python parity: rolling mean of range (NOT ta.atr RMA)
// =============================================================================
atrRaw = ta.sma(high - low, 14)
f_atrUse(float raw) =>
    float out = raw
    if out <= 0 or na(out)
        out := nz(raw[1], 0)
    if out <= 0
        for k = 2 to 5
            v = nz(raw[k], 0)
            if v > 0
                out := v
                break
    out <= 0 ? 1.0 : out
atrUse = f_atrUse(atrRaw)

// =============================================================================
// HTF — completed bars only (lookahead_off)
// =============================================================================
[m15C, m15C1, m15H, m15L, m15O] = request.security(syminfo.tickerid, "15", [close, close[1], high, low, open], lookahead=barmerge.lookahead_off)
[m5C, m5O, m5H, m5L, m5C1, m5H1, m5L1] = request.security(syminfo.tickerid, "5", [close, open, high, low, close[1], high[1], low[1]], lookahead=barmerge.lookahead_off)
m5AtrRaw = request.security(syminfo.tickerid, "5", ta.sma(high - low, 14), lookahead=barmerge.lookahead_off)
m15AtrRaw = request.security(syminfo.tickerid, "15", ta.sma(high - low, 14), lookahead=barmerge.lookahead_off)
m5Atr  = f_atrUse(m5AtrRaw)
m15Atr = f_atrUse(m15AtrRaw)

// 5M swings via security
m5PivotH = request.security(syminfo.tickerid, "5", ta.pivothigh(high, swingPeriod, swingPeriod), lookahead=barmerge.lookahead_off)
m5PivotL = request.security(syminfo.tickerid, "5", ta.pivotlow(low, swingPeriod, swingPeriod), lookahead=barmerge.lookahead_off)
var float m5LastSH = na
var float m5PrevSH = na
var float m5LastSL = na
var float m5PrevSL = na
if not na(m5PivotH)
    m5PrevSH := m5LastSH
    m5LastSH := m5PivotH
if not na(m5PivotL)
    m5PrevSL := m5LastSL
    m5LastSL := m5PivotL

// 15M structural refs (4-bar lookback proxy for HH/HL)
m15H4 = request.security(syminfo.tickerid, "15", high[4], lookahead=barmerge.lookahead_off)
m15L4 = request.security(syminfo.tickerid, "15", low[4], lookahead=barmerge.lookahead_off)
m15C12 = request.security(syminfo.tickerid, "15", close[12], lookahead=barmerge.lookahead_off)

// =============================================================================
// 1M causal swings
// =============================================================================
pivotHigh = ta.pivothigh(high, swingPeriod, swingPeriod)
pivotLow  = ta.pivotlow(low, swingPeriod, swingPeriod)
var float lastSH = na
var float lastSL = na
var float prevSH = na
var float prevSL = na
if not na(pivotHigh)
    prevSH := lastSH
    lastSH := pivotHigh
if not na(pivotLow)
    prevSL := lastSL
    lastSL := pivotLow

// sh/sl at i vs i-10 (context.py)
shCur  = ta.valuewhen(not na(pivotHigh), pivotHigh, 0)
shPrev = ta.valuewhen(not na(pivotHigh), pivotHigh, 1)
slCur  = ta.valuewhen(not na(pivotLow), pivotLow, 0)
slPrev = ta.valuewhen(not na(pivotLow), pivotLow, 1)
// Fallback to stored vars
shAtI   = na(shCur) ? lastSH : shCur
shAtI10 = na(shPrev) ? nz(lastSH[10], lastSH) : shPrev
slAtI   = na(slCur) ? lastSL : slCur
slAtI10 = na(slPrev) ? nz(lastSL[10], lastSL) : slPrev

// =============================================================================
// Helper: classify progress state (active_move.py)
// =============================================================================
f_classifyProgress(float prog) =>
    string s = "NEUTRAL"
    if prog >= strongProgressAtr
        s := "STRONG_UP"
    else if prog >= weakProgressAtr
        s := "UP"
    else if prog <= -strongProgressAtr
        s := "STRONG_DOWN"
    else if prog <= -weakProgressAtr
        s := "DOWN"
    else if math.abs(prog) < weakProgressAtr * 0.5
        s := "NEUTRAL"
    else
        s := "TRANSITION"
    s

f_scoreState(string st) =>
    st == "STRONG_UP" ? 2 : st == "UP" ? 1 : st == "STRONG_DOWN" ? -2 : st == "DOWN" ? -1 : 0

f_dominant(string s15, string s5, string s1) =>
    string dom = "NEUTRAL"
    if s15 == "STRONG_UP" or s15 == "STRONG_DOWN"
        dom := s15
    else if s5 == "STRONG_UP" or s5 == "STRONG_DOWN"
        dom := s5
    else if s1 == "STRONG_UP" or s1 == "STRONG_DOWN"
        dom := s1
    else if s15 == "UP" or s15 == "DOWN"
        dom := s15
    else if s5 == "UP" or s5 == "DOWN"
        dom := s5
    else if s1 == "UP" or s1 == "DOWN"
        dom := s1
    else
        dom := s5 != "NEUTRAL" ? s5 : s1
    dom

f_sideAligned(string dir, string dom) =>
    dir == "LONG" ? dom == "STRONG_UP" or dom == "UP" : dir == "SHORT" ? dom == "STRONG_DOWN" or dom == "DOWN" : false

// =============================================================================
// 15M context (context_15m.py — causal port)
// =============================================================================
f_ctx15() =>
    float bull = 0.0
    float bear = 0.0
    array<string> rs = array.new_string(0)
    if bar_index >= 20
        if not na(m15H) and not na(m15H4)
            if m15H > m15H4
                bull += 0.5
                array.push(rs, "15M_HH")
            else if m15H < m15H4
                bear += 0.5
                array.push(rs, "15M_LH")
        if not na(m15L) and not na(m15L4)
            if m15L > m15L4
                bull += 0.5
                array.push(rs, "15M_HL")
            else if m15L < m15L4
                bear += 0.5
                array.push(rs, "15M_LL")
        if not na(m15C12)
            prog = (m15C - m15C12) / m15Atr
            if prog > 0.5
                bull += 1.0
                array.push(rs, "15M_PROG_UP")
            else if prog < -0.5
                bear += 1.0
                array.push(rs, "15M_PROG_DN")
        rngHi = ta.highest(m15H, 8)
        rngLo = ta.lowest(m15L, 8)
        impulse = rngHi - rngLo
        if impulse / m15Atr > 2.0
            if m15C > m15C[8]
                bull += 0.5
                array.push(rs, "15M_IMP_BULL")
            else
                bear += 0.5
                array.push(rs, "15M_IMP_BEAR")
        rng = rngHi - rngLo
        pos = rng > 0 ? (m15C - rngLo) / rng : 0.5
        if pos > 0.7
            bull += 0.5
            array.push(rs, "15M_RANGE_HIGH")
        else if pos < 0.3
            bear += 0.5
            array.push(rs, "15M_RANGE_LOW")
        m5Rng = m5H - m5L
        m5Prior = ta.sma(m5H - m5L, 4)
        if m5Prior > 0 and m5Rng / m5Prior > 1.3
            if m5C > m5O
                bull += 0.5
                array.push(rs, "15M_EXP_BULL")
            else
                bear += 0.5
                array.push(rs, "15M_EXP_BEAR")
    net = bull - bear
    strength = math.max(-2.0, math.min(2.0, net))
    state = strength >= 1.0 ? "BULLISH" : strength <= -1.0 ? "BEARISH" : math.abs(strength) < 0.5 and (bull + bear) > 0 ? "TRANSITION" : "NEUTRAL"
    score = int(math.round(math.max(-2.0, math.min(2.0, strength))))
    [state, strength, score, bull, bear, rs]

[ctx15State, ctx15Strength, ctx15Score, ctx15Bull, ctx15Bear, ctx15Reasons] = f_ctx15()

// =============================================================================
// 5M structure (context_5m.py)
// =============================================================================
f_ctx5() =>
    int bull = 0
    int bear = 0
    array<string> rs = array.new_string(0)
    if bar_index >= 20
        if not na(m5LastSH) and not na(m5PrevSH)
            if m5LastSH > m5PrevSH
                bull += 1
                array.push(rs, "5M_HH")
            else if m5LastSH < m5PrevSH
                bear += 1
                array.push(rs, "5M_LH")
        if not na(m5LastSL) and not na(m5PrevSL)
            if m5LastSL > m5PrevSL
                bull += 1
                array.push(rs, "5M_HL")
            else if m5LastSL < m5PrevSL
                bear += 1
                array.push(rs, "5M_LL")
        mom5 = (m5C - m5C[5]) / m5Atr
        if mom5 > 0.3
            bull += 1
            array.push(rs, "5M_MOM_UP")
        else if mom5 < -0.3
            bear += 1
            array.push(rs, "5M_MOM_DN")
    net = bull - bear
    dir = net >= 2 ? "BULLISH" : net <= -2 ? "BEARISH" : "NEUTRAL"
    [dir, bull, bear, rs]

[ctx5Dir, ctx5Bull, ctx5Bear, ctx5Reasons] = f_ctx5()

// =============================================================================
// Phase58 context (context.py — swing i vs i-10, 5m body, 15m mom)
// =============================================================================
f_computeContext() =>
    int bullScore = 0
    int bearScore = 0
    array<string> reasons = array.new_string(0)
    if bar_index >= 20
        if not na(shAtI) and not na(shAtI10)
            if shAtI > shAtI10
                bullScore += 1
                array.push(reasons, "SWING_HH")
            else if shAtI < shAtI10
                bearScore += 1
                array.push(reasons, "SWING_LH")
        if not na(slAtI) and not na(slAtI10)
            if slAtI > slAtI10
                bullScore += 1
                array.push(reasons, "SWING_HL")
            else if slAtI < slAtI10
                bearScore += 1
                array.push(reasons, "SWING_LL")
        mom = (close - close[5]) / atrUse
        if mom > 0.3
            bullScore += 1
            array.push(reasons, "MOM_BULL")
        else if mom < -0.3
            bearScore += 1
            array.push(reasons, "MOM_BEAR")
        m5Body = (m5C - m5O) / m5Atr
        if m5Body > 0.2
            bullScore += 1
            array.push(reasons, "M5_BULL")
        else if m5Body < -0.2
            bearScore += 1
            array.push(reasons, "M5_BEAR")
        if bar_index > 15
            m15Mom = (m15C - m15C[15]) / m15Atr
            if m15Mom > 0.3
                bullScore += 1
                array.push(reasons, "M15_BULL")
            else if m15Mom < -0.3
                bearScore += 1
                array.push(reasons, "M15_BEAR")
    net = bullScore - bearScore
    dir = net >= 2 ? "BULLISH" : net <= -2 ? "BEARISH" : "NEUTRAL"
    conf = math.min(100, math.abs(net) * 25)
    [dir, conf, bullScore, bearScore, reasons]

// =============================================================================
// Location — 1M (location.py) + 5M (location_5m.py)
// =============================================================================
f_loc1m(string dir) =>
    int sc = 0
    array<string> rs = array.new_string(0)
    if bar_index >= 30
        float swingDist = na
        if dir == "LONG" and not na(lastSL)
            swingDist := math.abs(close - lastSL) / atrUse
            if swingDist < 0.5
                sc += 1
                array.push(rs, "NEAR_SWING_LOW")
        if dir == "SHORT" and not na(lastSH)
            swingDist := math.abs(close - lastSH) / atrUse
            if swingDist < 0.5
                sc += 1
                array.push(rs, "NEAR_SWING_HIGH")
        lb = 20
        if dir == "LONG"
            rh = ta.highest(high, lb)
            rl = ta.lowest(low, lb)
            imp = rh - rl
            pb = imp > 0 ? (rh - close) / imp : 0.0
            if pb >= 0.15 and pb <= 0.6
                sc += 1
                array.push(rs, "PB_HEALTHY_DEPTH")
            rngPos = imp > 0 ? (close - rl) / imp : 0.5
            if rngPos < 0.35
                sc += 1
                array.push(rs, "LOW_IN_RANGE")
        else
            rh = ta.highest(high, lb)
            rl = ta.lowest(low, lb)
            imp = rh - rl
            pb = imp > 0 ? (close - rl) / imp : 0.0
            if pb >= 0.15 and pb <= 0.6
                sc += 1
                array.push(rs, "PB_HEALTHY_DEPTH")
            rngPos = imp > 0 ? (close - rl) / imp : 0.5
            if rngPos > 0.65
                sc += 1
                array.push(rs, "HIGH_IN_RANGE")
    [sc, rs]

f_loc5m(string dir) =>
    int sc = 0
    array<string> rs = array.new_string(0)
    prox = 0.5
    if bar_index >= 30
        if dir == "LONG" and not na(m5LastSL)
            if math.abs(m5C - m5LastSL) / m5Atr < prox
                sc += 1
                array.push(rs, "5M_NEAR_SWING_LOW")
        if dir == "SHORT" and not na(m5LastSH)
            if math.abs(m5C - m5LastSH) / m5Atr < prox
                sc += 1
                array.push(rs, "5M_NEAR_SWING_HIGH")
        lb = 20
        if dir == "LONG"
            rh = ta.highest(m5H, lb)
            rl = ta.lowest(m5L, lb)
            imp = rh - rl
            pb = imp > 0 ? (rh - m5C) / imp : 0.0
            if pb >= 0.15 and pb <= 0.6
                sc += 1
                array.push(rs, "5M_PB_DEPTH_OK")
            if not na(m15L) and math.abs(m5C - m15L) / m5Atr < prox * 1.5
                sc += 1
                array.push(rs, "5M_NEAR_15M_LOW")
        else
            rh = ta.highest(m5H, lb)
            rl = ta.lowest(m5L, lb)
            imp = rh - rl
            pb = imp > 0 ? (m5C - rl) / imp : 0.0
            if pb >= 0.15 and pb <= 0.6
                sc += 1
                array.push(rs, "5M_PB_DEPTH_OK")
            if not na(m15H) and math.abs(m5C - m15H) / m5Atr < prox * 1.5
                sc += 1
                array.push(rs, "5M_NEAR_15M_HIGH")
    [math.min(sc, 2), rs]

f_locationScore(string dir) =>
    [l1, r1] = f_loc1m(dir)
    [l5, r5] = f_loc5m(dir)
    sc = math.min(3, l1 + l5)
    [sc, r1, r5]

// =============================================================================
// Reaction — 6 components (reaction.py)
// =============================================================================
f_failedExtension(string dir) =>
    bool active = false
    if bar_index >= 2
        if dir == "LONG"
            newExt = low < low[1]
            prog = newExt ? (low[1] - low) / atrUse : 0.0
            active := newExt and prog < 0.15 and close > close[1]
        else
            newExt = high > high[1]
            prog = newExt ? (high - high[1]) / atrUse : 0.0
            active := newExt and prog < 0.15 and close < close[1]
    active

f_momentumLoss(string dir) =>
    bool active = false
    if bar_index >= decelLookback + 1
        if dir == "LONG"
            m0 = math.abs(close[1] - close[2])
            m1 = math.abs(close[2] - close[3])
            m2 = math.abs(close[3] - close[4])
            sell0 = close[1] < close[2] ? m0 : 0.0
            sell1 = close[2] < close[3] ? m1 : 0.0
            active := sell0 > 0 and sell1 > 0 and sell0 < sell1 * 0.7
        else
            m0 = math.abs(close[1] - close[2])
            m1 = math.abs(close[2] - close[3])
            buy0 = close[1] > close[2] ? m0 : 0.0
            buy1 = close[2] > close[3] ? m1 : 0.0
            active := buy0 > 0 and buy1 > 0 and buy0 < buy1 * 0.7
    active

f_reclaim(string dir) =>
    bool active = false
    if bar_index >= 3
        prior = close[2]
        if dir == "LONG"
            active := close > prior and close[1] < prior
        else
            active := close < prior and close[1] > prior
    active

f_dirResponse(string dir) =>
    body = close - open
    absBody = math.abs(body) / atrUse
    dir == "LONG" ? body > 0 and absBody >= bodyThreshATR : body < 0 and absBody >= bodyThreshATR

f_microShift(string dir) =>
    bool shifted = false
    if bar_index >= microShiftBars
        if dir == "LONG"
            shifted := close > close[1] and close[1] > close[2]
        else
            shifted := close < close[1] and close[1] < close[2]
    shifted

f_rejection(string dir) =>
    br = high - low
    bool active = false
    if br > 0
        if dir == "LONG"
            lw = math.min(close, open) - low
            active := lw / br >= wickRejectionPct and close > open
        else
            uw = high - math.max(close, open)
            active := uw / br >= wickRejectionPct and close < open
    active

f_allReactions(string dir) =>
    int sc = 0
    array<string> rs = array.new_string(0)
    if f_failedExtension(dir)
        sc += 1
        array.push(rs, "FAILED_EXT")
    if f_momentumLoss(dir)
        sc += 1
        array.push(rs, "MOM_LOSS")
    if f_reclaim(dir)
        sc += 1
        array.push(rs, "RECLAIM")
    if f_dirResponse(dir)
        sc += 1
        array.push(rs, "DIR_RESPONSE")
    if f_microShift(dir)
        sc += 1
        array.push(rs, "MICRO_SHIFT")
    if f_rejection(dir)
        sc += 1
        array.push(rs, "REJECTION")
    [math.min(sc, 3), rs]

// =============================================================================
// 15M direction score (score_15m_for_direction)
// =============================================================================
f_score15m(string dir) =>
    int sc = 0
    array<string> rs = array.new_string(0)
    s = ctx15Score
    if dir == "LONG"
        if s > 0
            sc := math.min(2, s)
            array.push(rs, "15M_SUPPORT_" + str.tostring(sc))
        else if s < -1
            sc := math.max(-2, s)
            array.push(rs, "15M_CONTRA_" + str.tostring(s))
        else
            array.push(rs, "15M_NEUTRAL")
    else
        if s < 0
            sc := math.min(2, math.abs(s))
            array.push(rs, "15M_SUPPORT_" + str.tostring(sc))
        else if s > 1
            sc := math.max(-2, -s)
            array.push(rs, "15M_CONTRA_" + str.tostring(s))
        else
            array.push(rs, "15M_NEUTRAL")
    [sc, rs]

// =============================================================================
// Evidence (evidence.py) + decide variant E
// =============================================================================
f_computeEvidence(string dir) =>
    [locSc, lr1, lr5] = f_locationScore(dir)
    [c15, r15] = f_score15m(dir)
    dir5 = dir == "LONG" ? math.min(2, ctx5Bull) : math.min(2, ctx5Bear)
    dirSc = c15 + dir5
    [reactSc, reactRs] = f_allReactions(dir)
    contra = 0
    array<string> contraRs = array.new_string(0)
    if dir == "LONG" and ctx15State == "BEARISH" and ctx15Strength <= -1.0
        contra -= 1
        array.push(contraRs, "HTF_CONTRADICTION")
    if dir == "SHORT" and ctx15State == "BULLISH" and ctx15Strength >= 1.0
        contra -= 1
        array.push(contraRs, "HTF_CONTRADICTION")
    if dir == "LONG" and ctx5Dir == "BEARISH" and ctx5Bear >= 2
        contra -= 1
        array.push(contraRs, "5M_EXPANSION_AGAINST")
    if dir == "SHORT" and ctx5Dir == "BULLISH" and ctx5Bull >= 2
        contra -= 1
        array.push(contraRs, "5M_EXPANSION_AGAINST")
    total = locSc + dirSc + reactSc + contra
    [total, locSc, dirSc, reactSc, contra, r15, reactRs, contraRs]

f_decideE(int total, int reactSc, int contra, int waitUsed) =>
    string dec = "PASS"
    if total >= takeThreshold
        dec := "TAKE"
    else if reactSc >= 1 and total >= takeThreshold - 1
        dec := waitUsed < maxWaitBars ? "WAIT" : "TAKE"
    else if total <= 1 or contra <= -2
        dec := "PASS"
    else if waitUsed < maxWaitBars
        dec := "WAIT"
    else
        dec := "PASS"
    dec

// =============================================================================
// Active move + confidence (confidence.py + forensics enrich)
// =============================================================================
f_activeMove() =>
    p1 = bar_index >= progressLb1m ? (close - close[progressLb1m]) / atrUse : 0.0
    p5 = (m5C - m5C[progressLb5m]) / m5Atr
    p15 = (m15C - m15C[progressLb15m]) / m15Atr
    s1 = f_classifyProgress(p1)
    s5 = f_classifyProgress(p5)
    s15 = f_classifyProgress(p15)
    dom = f_dominant(s15, s5, s1)
    impLb = 12
    bullImp = (ta.highest(high, impLb) - ta.lowest(low, impLb)) / atrUse
    [dom, s1, s5, s15, p1, bullImp]

f_structFeatures() =>
    hh = not na(shAtI) and not na(shAtI10) and shAtI > shAtI10
    hl = not na(slAtI) and not na(slAtI10) and slAtI > slAtI10
    lh = not na(shAtI) and not na(shAtI10) and shAtI < shAtI10
    ll = not na(slAtI) and not na(slAtI10) and slAtI < slAtI10
    failUp = bar_index >= 2 and high > high[1] and (high - high[1]) / atrUse < 0.15 and close < close[1]
    failDn = bar_index >= 2 and low < low[1] and (low[1] - low) / atrUse < 0.15 and close > close[1]
    [hh or hl, lh or ll, failUp, failDn]

f_countertrend(string dom, float imp1m) =>
    lb = progressLb1m
    float ratio = 0.0
    if dom == "STRONG_UP" or dom == "UP"
        actImp = (high - ta.lowest(low, 12)) / atrUse
        ctEnd = ta.lowest(low, lb)
        counterImp = math.max(0.0, (high - ctEnd) / atrUse)
        ratio := actImp > 0.05 ? counterImp / actImp : 0.0
    else if dom == "STRONG_DOWN" or dom == "DOWN"
        actImp = (ta.highest(high, 12) - low) / atrUse
        ctEnd = ta.highest(high, lb)
        counterImp = math.max(0.0, (ctEnd - low) / atrUse)
        ratio := actImp > 0.05 ? counterImp / actImp : 0.0
    else
        ratio := math.abs((close - close[lb]) / atrUse) / math.max(imp1m, 0.5)
    ratio

f_structureContext(string dir, string dom, bool bullStruct, bool bearStruct, bool failUp, bool failDn) =>
    intact = dir == "LONG" ? bullStruct or dom == "STRONG_UP" or dom == "UP" or dom == "NEUTRAL" : bearStruct or dom == "STRONG_DOWN" or dom == "DOWN" or dom == "NEUTRAL"
    weakening = dir == "LONG" ? failUp or dom == "STRONG_DOWN" or dom == "DOWN" : failDn or dom == "STRONG_UP" or dom == "UP"
    oppStr = dir == "LONG" ? bearStruct or failUp : bullStruct or failDn
    [intact, weakening, oppStr]

f_reversalSupport(bool priorWeak, bool oppStr, float ctRatio, bool failUp, bool failDn, string dir) =>
    int sc = 0
    if priorWeak
        sc += 1
    if oppStr
        sc += 1
    if ctRatio >= ctReversal
        sc += 2
    else if ctRatio >= ctPullback
        sc += 1
    if dir == "LONG" and failUp
        sc += 1
    if dir == "SHORT" and failDn
        sc += 1
    sc >= 3 ? "STRONG" : sc >= 2 ? "MODERATE" : sc >= 1 ? "WEAK" : "NONE"

f_confidenceBand(int score) =>
    score >= 4 ? "VERY_HIGH" : score >= 2 ? "HIGH" : score >= 0 ? "MEDIUM" : score >= -2 ? "LOW" : "VERY_LOW"

f_computeConfidence(string dir) =>
    [dom, s1, s5, s15, p1, imp1m] = f_activeMove()
    [bullStruct, bearStruct, failUp, failDn] = f_structFeatures()
    ctRatio = f_countertrend(dom, imp1m)
    [structIntact, priorWeak, oppStr] = f_structureContext(dir, dom, bullStruct, bearStruct, failUp, failDn)
    aligned = f_sideAligned(dir, dom)
    domSc = f_scoreState(dom)
    int score = 0
    bool actAln = false
    bool actOpp = false
    bool structAln = false
    bool structOpp = false
    bool htfSup = false
    bool htfContra = false
    bool ctWeak = false
    bool ctStrong = false
    if dir == "LONG"
        if domSc >= 1
            score += 2
            actAln := true
        else if domSc <= -1
            score -= 2
            actOpp := true
    else
        if domSc <= -1
            score += 2
            actAln := true
        else if domSc >= 1
            score -= 2
            actOpp := true
    if structIntact
        score += 1
        structAln := true
    else
        score -= 1
        structOpp := true
    if dir == "LONG"
        if ctx15State == "BULLISH"
            score += 1
            htfSup := true
        else if ctx15State == "BEARISH" and ctx15Strength <= -1.0
            score -= 1
            htfContra := true
    else
        if ctx15State == "BEARISH"
            score += 1
            htfSup := true
        else if ctx15State == "BULLISH" and ctx15Strength >= 1.0
            score -= 1
            htfContra := true
    if ctRatio < ctPullback and aligned
        score += 1
        ctWeak := true
    else if ctRatio >= ctReversal and not aligned
        score += 1
        ctStrong := true
    revSup = f_reversalSupport(priorWeak, oppStr, ctRatio, failUp, failDn, dir)
    frRisk = "LOW"
    if not aligned and ctRatio < ctPullback
        frRisk := "MEDIUM"
    domBull = dom == "STRONG_UP" or dom == "UP"
    domBear = dom == "STRONG_DOWN" or dom == "DOWN"
    opposed = (dir == "SHORT" and domBull) or (dir == "LONG" and domBear)
    weakRev = not priorWeak and not oppStr
    if opposed and ctRatio < ctPullback and weakRev
        frRisk := "HIGH"
        score -= 2
    else if frRisk == "MEDIUM"
        score -= 1
    if revSup == "STRONG" or revSup == "MODERATE"
        if not aligned
            score += revSup == "STRONG" ? 2 : 1
    band = f_confidenceBand(score)
    missingVh = actAln and structAln and not htfSup and not ctWeak
    highSubtype = ""
    if band == "HIGH"
        revOk = revSup == "MODERATE" or revSup == "STRONG"
        highSubtype := actOpp and revOk ? "HIGH_REVERSAL" : missingVh ? "HIGH_CONFLICTED" : "HIGH_CLEAN"
    mktState = aligned and structIntact and ctRatio < ctPullback ? "CONTINUATION" : opposed and ctRatio < ctPullback ? "PULLBACK" : "UNCERTAIN"
    [band, score, revSup, dom, htfContra, missingVh, highSubtype, actAln, structAln, htfSup, ctWeak, frRisk, mktState]

// P4 (policies.py)
f_p4Abstain(string dir, string revSup, string dom) =>
    strongContra = (dir == "LONG" and ctx15State == "BEARISH" and (dom == "DOWN" or dom == "STRONG_DOWN")) or (dir == "SHORT" and ctx15State == "BULLISH" and (dom == "UP" or dom == "STRONG_UP"))
    weakRev = revSup == "NONE" or revSup == "WEAK"
    strongContra and weakRev

// H1 (filters.py) — abstain if HIGH_CONFLICTED and htf_contra_code
f_h1Abstain(string highSubtype, bool htfContraCode) =>
    highSubtype == "HIGH_CONFLICTED" and htfContraCode

// =============================================================================
// State variables — Layer A
// =============================================================================
// Phase58 trader: WATCH=0 ARMED_L=1 ARMED_S=-1 IN_L=2 IN_S=-2 COOLDOWN=3
var int   p58State = 0
var string p58Dir = ""
var int   armedBar = 0
var int   armedBars = 0
var float armedPrice = na
var float pbExtreme = na
var int   cooldownRem = 0

// Phase58 internal trade (0.75 ATR — blocks new signals)
var bool  p58InTrade = false
var string p58TradeDir = na
var int   p58EntryBar = na
var float p58Entry = na
var float p58Stop = na
var float p58Target = na
var int   p58Deadline = na

// Opportunity memory (Phase58D)
var string curOppId = na
var string curOppDir = na
var int   curOppLastSi = na
var int   curOppStartSi = na
var int   oppCounter = 0

// Pending canonical entry (T+1)
var bool   pendingTake = false
var string pendingDir = na
var int    pendingSignalBar = na
var string pendingOppId = na
var string pendingReason = na

// M1 canonical trades (up to 8 concurrent)
MAX_TRADES = 8
var array<int>    tEntryBar = array.new_int(0)
var array<string> tDir = array.new_string(0)
var array<float>  tEntry = array.new_float(0)
var array<float>  tStop = array.new_float(0)
var array<float>  tTarget = array.new_float(0)
var array<int>    tDeadline = array.new_int(0)
var array<bool>   tActive = array.new_bool(0)

// Display state (updated each confirmed bar)
var string decisionLabel = "WATCH"
var string p58dDecision = ""
var string p4Status = "KEEP"
var string h1Status = "KEEP"
var string confBand = ""
var string domActive = "NEUTRAL"
var int    lastEvidence = 0

f_addM1Trade(string dir, float ep, int eBar) =>
    risk = m1StopAtr * atrUse
    st = dir == "LONG" ? ep - risk : ep + risk
    tg = dir == "LONG" ? ep + targetR * risk : ep - targetR * risk
    dl = eBar + maxHoldBars
    if array.size(tActive) >= MAX_TRADES
        array.shift(tEntryBar)
        array.shift(tDir)
        array.shift(tEntry)
        array.shift(tStop)
        array.shift(tTarget)
        array.shift(tDeadline)
        array.shift(tActive)
    array.push(tEntryBar, eBar)
    array.push(tDir, dir)
    array.push(tEntry, ep)
    array.push(tStop, st)
    array.push(tTarget, tg)
    array.push(tDeadline, dl)
    array.push(tActive, true)

// Layer B debug-only auto entry log (does NOT affect signals)
var array<int>    dbgAutoEntryMs = array.new_int(0)
var array<string> dbgAutoEntryDir = array.new_string(0)

f_dbgLogAutoEntry(string dir) =>
    if debugParityMarkers
        array.push(dbgAutoEntryMs, time)
        array.push(dbgAutoEntryDir, dir)

f_refMatch(int refMs, string refDir) =>
    bool refHit = debugParityMarkers and time == refMs
    bool autoHit = false
    string autoDir = ""
    if debugParityMarkers and array.size(dbgAutoEntryMs) > 0
        for i = 0 to array.size(dbgAutoEntryMs) - 1
            if array.get(dbgAutoEntryMs, i) == time
                autoHit := true
                autoDir := array.get(dbgAutoEntryDir, i)
                break
    string tag = ""
    if refHit or autoHit
        if refHit and autoHit
            tag := refDir == autoDir ? "PARITY ✓" : "DIR MISMATCH ✗"
        else if refHit
            tag := "REF ONLY ✗"
        else
            tag := "AUTO ONLY ✗"
    [refHit, autoHit, tag]

// =============================================================================
// Main bar logic — Layer A (closed bar only)
// =============================================================================
if barstate.isconfirmed and not TZ_WARN and bar_index >= WARMUP
    decisionLabel := "WATCH"
    p58dDecision := ""
    p4Status := "KEEP"
    h1Status := "KEEP"

    // ── Execute pending canonical entry at T+1 open ───────────────────────
    if pendingTake and bar_index == pendingSignalBar + 1
        ep = open
        f_addM1Trade(pendingDir, ep, bar_index)
        f_dbgLogAutoEntry(pendingDir)
        if showEntry
            label.new(bar_index, ep, "ENTRY " + pendingDir + "\n" + pendingOppId, style=pendingDir == "LONG" ? label.style_label_up : label.style_label_down, color=color.white, textcolor=color.black, size=size.small)
        pendingTake := false
        pendingDir := na
        pendingSignalBar := na
        pendingOppId := na

    // ── Manage M1 canonical trades (entry bar excluded, stop before target) ─
    for i = 0 to array.size(tActive) - 1
        if array.get(tActive, i)
            eBar = array.get(tEntryBar, i)
            if bar_index > eBar
                dir = array.get(tDir, i)
                st = array.get(tStop, i)
                tg = array.get(tTarget, i)
                dl = array.get(tDeadline, i)
                hitStop = dir == "LONG" ? low <= st : high >= st
                hitTgt = dir == "LONG" ? high >= tg : low <= tg
                if hitStop
                    array.set(tActive, i, false)
                    if showExits
                        label.new(bar_index, st, "STOP " + dir, style=label.style_label_left, color=color.red, textcolor=color.white, size=size.tiny)
                else if hitTgt
                    array.set(tActive, i, false)
                    if showExits
                        label.new(bar_index, tg, "TARGET " + dir, style=label.style_label_left, color=color.lime, textcolor=color.black, size=size.tiny)
                else if bar_index >= dl
                    array.set(tActive, i, false)
                    if showExits
                        label.new(bar_index, close, "TIME " + dir, style=label.style_label_left, color=color.gray, textcolor=color.white, size=size.tiny)

    // ── Manage Phase58 internal trade (0.75 ATR) ────────────────────────
    if p58InTrade and bar_index > p58EntryBar
        dir = p58TradeDir
        hitStop = dir == "LONG" ? low <= p58Stop : high >= p58Stop
        hitTgt = dir == "LONG" ? high >= p58Target : low <= p58Target
        if hitStop or hitTgt or bar_index >= p58Deadline
            p58InTrade := false
            p58State := 3
            cooldownRem := cooldownBars
            p58TradeDir := na

    // ── Cooldown ──────────────────────────────────────────────────────────
    if p58State == 3 and not p58InTrade
        cooldownRem -= 1
        if cooldownRem <= 0
            p58State := 0
            p58Dir := ""
            armedBar := 0
            armedBars := 0
            armedPrice := na
            pbExtreme := na
        decisionLabel := "COOLDOWN"

    // ── Signal generation (blocked while in Phase58 internal trade) ───────
    if not p58InTrade and p58State != 3
        [ctxDir, ctxConf, bullSc, bearSc, ctxRs] = f_computeContext()

        // WATCH → ARMED
        if p58State == 0
            string tradeDir = ctxDir == "BULLISH" ? "LONG" : ctxDir == "BEARISH" ? "SHORT" : ""
            if tradeDir != ""
                [locSc, _, _] = f_locationScore(tradeDir)
                ctxSc = math.min(2, tradeDir == "LONG" ? bullSc : bearSc)
                totalArm = ctxSc + locSc
                if totalArm >= armedMinScore
                    p58State := tradeDir == "LONG" ? 1 : -1
                    p58Dir := tradeDir
                    armedBar := bar_index
                    armedBars := 0
                    armedPrice := close
                    pbExtreme := close
                    decisionLabel := "ARMED " + tradeDir

        // ARMED → raw TAKE / WAIT / PASS / INVALIDATED
        if p58State == 1 or p58State == -1
            armedBars += 1
            dirStr = p58Dir
            tradeDirInt = dirStr == "LONG" ? 1 : -1
            if dirStr == "LONG"
                pbExtreme := math.min(pbExtreme, low)
            else
                pbExtreme := math.max(pbExtreme, high)

            // Armed timeout
            if armedBars > armedTimeoutBars
                p58State := 0
                p58Dir := ""
                armedBar := 0
                armedBars := 0
                armedPrice := na
                pbExtreme := na
                decisionLabel := "INVALIDATED"
                if showPass
                    label.new(bar_index, close, "TIMEOUT", style=label.style_label_center, color=color.gray, size=size.tiny)

            // Context contradiction
            else if (dirStr == "LONG" and ctxDir == "BEARISH") or (dirStr == "SHORT" and ctxDir == "BULLISH")
                p58State := 0
                p58Dir := ""
                armedBar := 0
                armedBars := 0
                armedPrice := na
                pbExtreme := na
                decisionLabel := "INVALIDATED"
                if showPass
                    label.new(bar_index, close, "CTX_CONTRA", style=label.style_label_center, color=color.gray, size=size.tiny)

            else
                [reactSc, reactRs] = f_allReactions(dirStr)
                [locSc, _, _] = f_locationScore(dirStr)
                ctxSc = math.min(2, dirStr == "LONG" ? bullSc : bearSc)
                contra = 0
                if dirStr == "LONG" and ctxDir == "NEUTRAL" and bearSc >= 2
                    contra -= 1
                if dirStr == "SHORT" and ctxDir == "NEUTRAL" and bullSc >= 2
                    contra -= 1
                total = ctxSc + locSc + reactSc + contra
                deterioration = dirStr == "LONG" ? (close - armedPrice) / atrUse : (armedPrice - close) / atrUse

                // Anti-chase
                if deterioration > maxChaseATR and reactSc >= 1
                    p58State := 0
                    p58Dir := ""
                    armedBar := 0
                    armedBars := 0
                    armedPrice := na
                    pbExtreme := na
                    decisionLabel := "MISSED"
                    if showPass
                        label.new(bar_index, close, "NO_CHASE", style=label.style_label_center, color=color.gray, size=size.tiny)

                else if total >= takeThreshold
                    // ── Raw Phase58 TAKE → Phase58D pipeline ──────────────
                    rawTake = true
                    isNew = na(curOppId) or dirStr != curOppDir or (bar_index - curOppLastSi) > structGap
                    if isNew
                        oppCounter += 1
                        curOppId := "OPP_" + str.tostring(bar_index) + "_" + dirStr
                        curOppDir := dirStr
                        curOppStartSi := bar_index
                        curOppLastSi := bar_index

                        [evTotal, evLoc, evDir, evReact, evContra, _, _, _] = f_computeEvidence(dirStr)
                        lastEvidence := evTotal
                        decE = f_decideE(evTotal, evReact, evContra, 0)
                        p58dDecision := decE

                        if decE == "WAIT"
                            decisionLabel := "WAIT"
                            if showWait
                                label.new(bar_index, close, "WAIT " + dirStr, style=label.style_label_center, color=color.blue, size=size.tiny)
                        else if decE == "PASS"
                            decisionLabel := "PASS"
                            if showPass
                                label.new(bar_index, close, "PASS", style=label.style_label_center, color=color.gray, size=size.tiny)
                        else if decE == "TAKE"
                            [band, cScore, revSup, dom, htfContraCode, missingVh, highSub, _, _, _, _, _, mkt] = f_computeConfidence(dirStr)
                            confBand := band
                            domActive := dom
                            p4Abst = f_p4Abstain(dirStr, revSup, dom)
                            h1Abst = f_h1Abstain(highSub, htfContraCode)
                            p4Status := p4Abst ? "ABSTAIN" : "KEEP"
                            h1Status := h1Abst ? "ABSTAIN" : "KEEP"

                            if p4Abst
                                decisionLabel := "P4 ABSTAIN"
                                if showP4Abst
                                    label.new(bar_index, close, "P4 ABSTAIN", style=label.style_label_center, color=color.orange, size=size.tiny)
                            else if h1Abst
                                decisionLabel := "H1 ABSTAIN"
                                if showH1Abst
                                    label.new(bar_index, close, "H1 ABSTAIN", style=label.style_label_center, color=color.fuchsia, size=size.tiny)
                            else
                                // Canonical TAKE = Phase58D TAKE AND P4 KEEP AND H1 KEEP
                                decisionLabel := "TAKE " + dirStr
                                pendingTake := true
                                pendingDir := dirStr
                                pendingSignalBar := bar_index
                                pendingOppId := curOppId
                                pendingReason := "TAKE_" + dirStr + " | E=" + str.tostring(evTotal) + " | 15m=" + ctx15State + " | P4=" + p4Status + " | H1=" + h1Status + " | band=" + band
                                if showTake
                                    label.new(bar_index, close, "TAKE " + dirStr, style=label.style_label_center, color=dirStr == "LONG" ? color.green : color.red, textcolor=color.white, size=size.small)

                                // Phase58 internal trade (0.75 ATR — blocks further signals)
                                ep58 = close  // signal bar close; entry next bar in Python uses cl[entry_i]
                                risk58 = p58StopAtr * atrUse
                                p58InTrade := true
                                p58TradeDir := dirStr
                                p58EntryBar := bar_index + 1
                                p58Entry := open  // will be set next bar; placeholder
                                p58Stop := dirStr == "LONG" ? ep58 - risk58 : ep58 + risk58
                                p58Target := dirStr == "LONG" ? ep58 + targetR * risk58 : ep58 - targetR * risk58
                                p58Deadline := bar_index + 1 + maxHoldBars
                                p58State := dirStr == "LONG" ? 2 : -2
                                armedBar := 0
                                armedBars := 0
                                armedPrice := na
                                pbExtreme := na
                    else
                        curOppLastSi := bar_index
                        decisionLabel := "UPDATE"
                else
                    decisionLabel := reactSc >= 1 ? "WAIT" : "ARMED"
                    if reactSc >= 1 and showWait
                        label.new(bar_index, close, "ARMED/WAIT", style=label.style_label_center, color=color.blue, size=size.tiny)

    // Fix Phase58 entry price on entry bar
    if p58InTrade and bar_index == p58EntryBar
        p58Entry := open
        risk58 = p58StopAtr * atrUse
        p58Stop := p58TradeDir == "LONG" ? p58Entry - risk58 : p58Entry + risk58
        p58Target := p58TradeDir == "LONG" ? p58Entry + targetR * risk58 : p58Entry - targetR * risk58

// =============================================================================
// Layer B — parity debug markers (fully isolated from Layer A)
// =============================================================================
if debugParityMarkers and barstate.isconfirmed
    [r1, a1, t1] = f_refMatch(refEntryUnixMs, refDirection)
    if r1
        label.new(bar_index, open, "REFERENCE\n" + refDirection + "\n" + t1, style=label.style_label_up, color=color.yellow, textcolor=color.black, size=size.small)
    [r2, a2, t2] = f_refMatch(refEntryUnixMs2, refDirection2)
    if r2
        label.new(bar_index, open, "REFERENCE #2\n" + refDirection2 + "\n" + t2, style=label.style_label_up, color=color.yellow, textcolor=color.black, size=size.tiny)
    [r3, a3, t3] = f_refMatch(refEntryUnixMs3, refDirection3)
    if r3
        label.new(bar_index, open, "REFERENCE #3\n" + refDirection3 + "\n" + t3, style=label.style_label_up, color=color.yellow, textcolor=color.black, size=size.tiny)

// Plot stop/target for most recent active M1 trade
activeN = array.size(tActive)
float plotStop = na
float plotTgt = na
if activeN > 0 and showStopTgt
    for i = activeN - 1 to 0
        if array.get(tActive, i)
            plotStop := array.get(tStop, i)
            plotTgt := array.get(tTarget, i)
            break
plot(plotStop, "M1 Stop", color.red, 2, plot.style_linebr)
plot(plotTgt, "M1 Target", color.teal, 2, plot.style_linebr)

// Phase58K extension diagnostic (display only)
m5MoveAtr = math.abs(m5C - m5C[10]) / atrUse
move20Atr = math.abs(close - close[20]) / atrUse

var table dbg = table.new(position.top_right, 2, 18, bgcolor=color.new(color.black, 85))
if barstate.islast and showDebug
    table.cell(dbg, 0, 0, "PHASE59B CANONICAL", text_color=color.yellow, text_size=size.small)
    table.cell(dbg, 1, 0, "D(E)→P4→H1→M1", text_color=color.yellow, text_size=size.small)
    table.cell(dbg, 0, 1, "1M TF", text_color=color.gray)
    table.cell(dbg, 1, 1, TZ_WARN ? "WARN: not 1M" : "OK", text_color=TZ_WARN ? color.red : color.lime)
    table.cell(dbg, 0, 2, "decision", text_color=color.gray)
    table.cell(dbg, 1, 2, decisionLabel, text_color=color.white)
    table.cell(dbg, 0, 3, "phase58d", text_color=color.gray)
    table.cell(dbg, 1, 3, p58dDecision == "" ? "-" : p58dDecision, text_color=color.white)
    table.cell(dbg, 0, 4, "opportunity", text_color=color.gray)
    table.cell(dbg, 1, 4, na(curOppId) ? "-" : curOppId, text_color=color.white)
    table.cell(dbg, 0, 5, "P4", text_color=color.gray)
    table.cell(dbg, 1, 5, p4Status, text_color=color.white)
    table.cell(dbg, 0, 6, "H1", text_color=color.gray)
    table.cell(dbg, 1, 6, h1Status, text_color=color.white)
    table.cell(dbg, 0, 7, "confidence", text_color=color.gray)
    table.cell(dbg, 1, 7, confBand == "" ? "-" : confBand, text_color=color.white)
    table.cell(dbg, 0, 8, "dominant", text_color=color.gray)
    table.cell(dbg, 1, 8, domActive, text_color=color.white)
    table.cell(dbg, 0, 9, "evidence", text_color=color.gray)
    table.cell(dbg, 1, 9, str.tostring(lastEvidence), text_color=color.white)
    if showHTF
        table.cell(dbg, 0, 10, "15M", text_color=color.gray)
        table.cell(dbg, 1, 10, ctx15State + " (" + str.tostring(ctx15Strength, "#.##") + ")", text_color=color.white)
        table.cell(dbg, 0, 11, "5M", text_color=color.gray)
        table.cell(dbg, 1, 11, ctx5Dir, text_color=color.white)
    table.cell(dbg, 0, 12, "ATR", text_color=color.gray)
    table.cell(dbg, 1, 12, str.tostring(atrUse, "#.####"), text_color=color.white)
    table.cell(dbg, 0, 13, "pending", text_color=color.gray)
    table.cell(dbg, 1, 13, pendingTake ? pendingDir : "-", text_color=color.white)
    actCnt = 0
    for i = 0 to array.size(tActive) - 1
        if array.get(tActive, i)
            actCnt += 1
    table.cell(dbg, 0, 14, "M1 active", text_color=color.gray)
    table.cell(dbg, 1, 14, str.tostring(actCnt), text_color=color.white)
    table.cell(dbg, 0, 15, "p58 internal", text_color=color.gray)
    table.cell(dbg, 1, 15, p58InTrade ? p58TradeDir : "-", text_color=color.white)
    if showReason and not na(pendingReason) and pendingReason != ""
        table.cell(dbg, 0, 16, "reason", text_color=color.gray)
        table.cell(dbg, 1, 16, pendingReason, text_color=color.silver, text_size=size.tiny)
    else if showExtDiag
        table.cell(dbg, 0, 16, "m5_move_atr", text_color=color.gray)
        table.cell(dbg, 1, 16, str.tostring(m5MoveAtr, "#.##"), text_color=color.white)
        table.cell(dbg, 0, 17, "move_20_atr", text_color=color.gray)
        table.cell(dbg, 1, 17, str.tostring(move20Atr, "#.##"), text_color=color.white)

if barstate.islast and TZ_WARN
    label.new(bar_index, high, "Phase59B: use 1-minute chart", style=label.style_label_down, color=color.red, textcolor=color.white, size=size.normal)

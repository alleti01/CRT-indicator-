{
  "phase": 74,
  "extends": "phase73/config/default.json",
  "mode": {
    "shadow_mode": true,
    "paper_mode": true,
    "trading_enabled": false,
    "external_order_routing": false
  },
  "market_data": {
    "provider": "STREAM_LIVE_PROVIDER",
    "symbol": "NQ",
    "exchange": "GLBX",
    "bar_timezone": "UTC",
    "staleness_limit_seconds": 90,
    "atr_period": 14,
    "databento_dataset": "GLBX.MDP3",
    "databento_schema": "ohlcv-1m",
    "databento_symbol": "NQ.v.0",
    "ninjatrader_host": "127.0.0.1",
    "ninjatrader_port": 8765,
    "ninjatrader_auth_env_var": "NINJATRADER_BRIDGE_TOKEN",
    "ninjatrader_bootstrap_bars": 15,
    "ninjatrader_expected_contract_prefix": "NQ",
    "ninjatrader_preserve_bars_on_disconnect": true,
    "log_bars_csv": true
  },
  "simulation": {
    "entry_slippage_ticks": 1.0,
    "exit_slippage_ticks": 1.0
  },
  "webhook": {
    "host": "127.0.0.1",
    "port": 8787,
    "path": "/webhook",
    "auth_env_var": "PHASE74_WEBHOOK_SECRET",
    "rate_limit_per_minute": 60,
    "staleness_limit_seconds": 120
  },
  "broker": {
    "adapter": "LOCAL_SIM",
    "paper_mode_required": true,
    "protective_orders": "CLIENT_SIDE_PROTECTION",
    "tradovate_env_prefix": "TRADOVATE_"
  },
  "contracts": {
    "pine_symbol": "NQ",
    "market_data_symbol": "NQ.v.0",
    "broker_symbol": "NQ",
    "multiplier": 2.0,
    "tick_size": 0.25,
    "tick_value": 0.5,
    "default_quantity": 1
  },
  "quality_gates": {
    "enabled": true,
    "lookback_bars": 20,
    "chop_box_atr": 2.0,
    "false_break_percentile": 0.15,
    "false_break_edge_atr": 0.25,
    "late_move_atr": 1.0,
    "day_max_losers": 3,
    "day_max_loss_r": 2.0
  },
  "trail_overlay": {
    "enabled": true,
    "bank_trigger_r": 2.5,
    "lock_stop_r": 2.0,
    "trail_atr": 1.0
  },
  "safety": {
    "daily_loss_limit": 500.0,
    "max_open_orders": 2,
    "kill_switch_env_var": "PHASE74_KILL_SWITCH"
  },
  "logging": {
    "log_dir": "phase74/logs"
  },
  "persistence": {
    "state_file": "phase74/logs/trader_state.json",
    "idempotency_file": "phase74/logs/order_idempotency.jsonl"
  }
}

//@version=5
// Phase58 — Early Market-Watching Trader v1
// Historical chart review indicator — NO repainting, closed bars only
indicator("Phase58 Trader v1", overlay=true, max_labels_count=500, max_bars_back=5000)

// ── Inputs ──────────────────────────────────────────────────────────
showArmed     = input.bool(true, "Show Armed markers")
showTake      = input.bool(true, "Show Take markers")
showPass      = input.bool(true, "Show Pass/Invalidated")
showMissed    = input.bool(true, "Show Missed No Chase")
showExits     = input.bool(true, "Show Exit markers")
showContext   = input.bool(true, "Show Context background")
showDebug     = input.bool(false, "Show Debug table")
swingPeriod   = input.int(5, "Swing Period", minval=2)
takeThreshold = input.int(4, "Take Threshold", minval=1)
armedMinScore = input.int(2, "Armed Min Score", minval=1)
maxChaseATR   = input.float(1.5, "Max Chase ATR")
stopATR       = input.float(0.75, "Stop ATR")
targetR       = input.float(2.5, "Target R")
maxHoldBars   = input.int(60, "Max Hold Bars")
bodyThreshATR = input.float(0.3, "Body Threshold ATR")
wickRejectPct = input.float(0.5, "Wick Rejection %")
cooldownBars  = input.int(3, "Cooldown Bars")
armedTimeout  = input.int(15, "Armed Timeout Bars")

// ── Causal Swing Detection ──────────────────────────────────────────
pivotHigh = ta.pivothigh(high, swingPeriod, swingPeriod)
pivotLow  = ta.pivotlow(low, swingPeriod, swingPeriod)
var float lastSH = na
var float lastSL = na
var float prevSH = na
var float prevSL = na
if not na(pivotHigh)
    prevSH := lastSH
    lastSH := pivotHigh
if not na(pivotLow)
    prevSL := lastSL
    lastSL := pivotLow

// ── ATR ─────────────────────────────────────────────────────────────
atrVal = ta.atr(14)

// ── Context ─────────────────────────────────────────────────────────
bullScore = 0
bearScore = 0
// Swing progression
if not na(lastSH) and not na(prevSH)
    if lastSH > prevSH
        bullScore += 1
    else if lastSH < prevSH
        bearScore += 1
if not na(lastSL) and not na(prevSL)
    if lastSL > prevSL
        bullScore += 1
    else if lastSL < prevSL
        bearScore += 1
// 1M momentum
mom5 = (close - close[5]) / atrVal
if mom5 > 0.3
    bullScore += 1
else if mom5 < -0.3
    bearScore += 1
// 5M direction
[m5Open, m5Close] = request.security(syminfo.tickerid, "5", [open, close], lookahead=barmerge.lookahead_off)
m5Body = (m5Close - m5Open) / atrVal
if m5Body > 0.2
    bullScore += 1
else if m5Body < -0.2
    bearScore += 1

ctxNet = bullScore - bearScore
ctxDir = ctxNet >= 2 ? 1 : ctxNet <= -2 ? -1 : 0

// ── State Machine ───────────────────────────────────────────────────
var int   state = 0       // 0=WATCH, 1=ARMED_L, -1=ARMED_S, 2=IN_L, -2=IN_S, 3=COOLDOWN
var int   tradeDir = 0
var float armedPrice = na
var int   armedBar = 0
var float pbExtreme = na
var float entryPrice = na
var float stopPrice = na
var float targetPrice = na
var int   entryBar = 0
var int   cooldown = 0

// Location score
locScore = 0
if tradeDir == 1 and not na(lastSL)
    if math.abs(close - lastSL) / atrVal < 0.5
        locScore += 1
else if tradeDir == -1 and not na(lastSH)
    if math.abs(close - lastSH) / atrVal < 0.5
        locScore += 1
// Pullback depth
lb = 20
recentHigh = ta.highest(high, lb)
recentLow  = ta.lowest(low, lb)
impulse = recentHigh - recentLow
pbDepth = tradeDir == 1 ? (recentHigh - close) / impulse : (close - recentLow) / impulse
if pbDepth >= 0.15 and pbDepth <= 0.6
    locScore += 1

// Reaction evidence
reactScore = 0
reactReasons = ""
// A: Failed extension
if tradeDir == 1 and low < low[1] and (low[1] - low) / atrVal < 0.15 and close > close[1]
    reactScore += 1
    reactReasons += "FE "
else if tradeDir == -1 and high > high[1] and (high - high[1]) / atrVal < 0.15 and close < close[1]
    reactScore += 1
    reactReasons += "FE "
// D: Directional response
body = close - open
if tradeDir == 1 and body > 0 and math.abs(body) / atrVal >= bodyThreshATR
    reactScore += 1
    reactReasons += "DR "
else if tradeDir == -1 and body < 0 and math.abs(body) / atrVal >= bodyThreshATR
    reactScore += 1
    reactReasons += "DR "
// F: Rejection wick
barRange = high - low
if barRange > 0
    if tradeDir == 1 and close > open
        lowerWick = math.min(close, open) - low
        if lowerWick / barRange >= wickRejectPct
            reactScore += 1
            reactReasons += "RJ "
    else if tradeDir == -1 and close < open
        upperWick = high - math.max(close, open)
        if upperWick / barRange >= wickRejectPct
            reactScore += 1
            reactReasons += "RJ "

reactScore := math.min(reactScore, 3)

// Contradiction
contra = 0
if tradeDir == 1 and bearScore >= 2
    contra -= 1
else if tradeDir == -1 and bullScore >= 2
    contra -= 1

ctxScore = tradeDir == 1 ? math.min(bullScore, 2) : tradeDir == -1 ? math.min(bearScore, 2) : 0
totalScore = ctxScore + locScore + reactScore + contra

// Entry deterioration
detATR = tradeDir == 1 ? (close - armedPrice) / atrVal : (armedPrice - close) / atrVal

// ── State transitions (on confirmed bar) ────────────────────────────
if barstate.isconfirmed
    if state == 3  // COOLDOWN
        cooldown -= 1
        if cooldown <= 0
            state := 0
            tradeDir := 0

    else if state == 2 or state == -2  // IN TRADE
        if bar_index > entryBar
            d = state == 2 ? 1 : -1
            risk = math.abs(entryPrice - stopPrice)
            if risk > 0
                if d == 1
                    if low <= stopPrice
                        state := 3
                        cooldown := cooldownBars
                        if showExits
                            label.new(bar_index, low, "STOP", style=label.style_circle, color=color.red, textcolor=color.white, size=size.tiny)
                    else if high >= targetPrice
                        state := 3
                        cooldown := cooldownBars
                        if showExits
                            label.new(bar_index, high, "TGT", style=label.style_circle, color=color.green, textcolor=color.white, size=size.tiny)
                    else if bar_index - entryBar >= maxHoldBars
                        state := 3
                        cooldown := cooldownBars
                        if showExits
                            label.new(bar_index, close, "TIME", style=label.style_circle, color=color.gray, textcolor=color.white, size=size.tiny)
                else
                    if high >= stopPrice
                        state := 3
                        cooldown := cooldownBars
                        if showExits
                            label.new(bar_index, high, "STOP", style=label.style_circle, color=color.red, textcolor=color.white, size=size.tiny)
                    else if low <= targetPrice
                        state := 3
                        cooldown := cooldownBars
                        if showExits
                            label.new(bar_index, low, "TGT", style=label.style_circle, color=color.green, textcolor=color.white, size=size.tiny)
                    else if bar_index - entryBar >= maxHoldBars
                        state := 3
                        cooldown := cooldownBars
                        if showExits
                            label.new(bar_index, close, "TIME", style=label.style_circle, color=color.gray, textcolor=color.white, size=size.tiny)

    else if state == 0  // WATCH
        if ctxDir == 1
            tradeDir := 1
            if ctxScore + locScore >= armedMinScore
                state := 1
                armedPrice := close
                armedBar := bar_index
                pbExtreme := close
                if showArmed
                    label.new(bar_index, low, "▲ ARM", style=label.style_triangleup, color=color.blue, textcolor=color.white, size=size.tiny)
        else if ctxDir == -1
            tradeDir := -1
            if ctxScore + locScore >= armedMinScore
                state := -1
                armedPrice := close
                armedBar := bar_index
                pbExtreme := close
                if showArmed
                    label.new(bar_index, high, "▼ ARM", style=label.style_triangledown, color=color.orange, textcolor=color.white, size=size.tiny)

    else if state == 1 or state == -1  // ARMED
        // Update running pullback extreme
        if state == 1
            pbExtreme := math.min(pbExtreme, low)
        else
            pbExtreme := math.max(pbExtreme, high)

        // Timeout
        if bar_index - armedBar > armedTimeout
            state := 0
            tradeDir := 0
            if showPass
                label.new(bar_index, close, "TO", style=label.style_xcross, color=color.gray, size=size.tiny)

        // Context contradiction
        else if (state == 1 and ctxDir == -1) or (state == -1 and ctxDir == 1)
            state := 0
            tradeDir := 0
            if showPass
                label.new(bar_index, close, "INV", style=label.style_xcross, color=color.gray, size=size.tiny)

        // Anti-chase
        else if detATR > maxChaseATR and reactScore >= 1
            state := 0
            tradeDir := 0
            if showMissed
                label.new(bar_index, close, "MISS", style=label.style_diamond, color=color.purple, textcolor=color.white, size=size.tiny)

        // TAKE
        else if totalScore >= takeThreshold
            entryPrice := close
            risk2 = stopATR * atrVal
            d2 = state == 1 ? 1 : -1
            stopPrice := entryPrice - risk2 * d2
            targetPrice := entryPrice + targetR * risk2 * d2
            entryBar := bar_index
            state := state == 1 ? 2 : -2
            if showTake
                lbl = (state == 2 ? "▲ LONG" : "▼ SHORT") + "\nS:" + str.tostring(totalScore)
                label.new(bar_index, state == 2 ? low : high, lbl,
                     style=state == 2 ? label.style_label_up : label.style_label_down,
                     color=state == 2 ? color.teal : color.maroon,
                     textcolor=color.white, size=size.small)

// ── Context background ──────────────────────────────────────────────
bgcolor(showContext and ctxDir == 1 ? color.new(color.green, 95) : showContext and ctxDir == -1 ? color.new(color.red, 95) : na)

// ── Debug table ─────────────────────────────────────────────────────
if showDebug and barstate.islast
    var table debugTbl = table.new(position.top_right, 2, 10, bgcolor=color.new(color.black, 80))
    table.cell(debugTbl, 0, 0, "State", text_color=color.white, text_size=size.small)
    stateStr = state == 0 ? "WATCH" : state == 1 ? "ARMED_L" : state == -1 ? "ARMED_S" : state == 2 ? "IN_LONG" : state == -2 ? "IN_SHORT" : "COOL"
    table.cell(debugTbl, 1, 0, stateStr, text_color=color.yellow, text_size=size.small)
    table.cell(debugTbl, 0, 1, "Context", text_color=color.white, text_size=size.small)
    table.cell(debugTbl, 1, 1, ctxDir == 1 ? "BULL" : ctxDir == -1 ? "BEAR" : "NEUT", text_color=color.yellow, text_size=size.small)
    table.cell(debugTbl, 0, 2, "Score", text_color=color.white, text_size=size.small)
    table.cell(debugTbl, 1, 2, str.tostring(totalScore), text_color=color.yellow, text_size=size.small)
    table.cell(debugTbl, 0, 3, "PB Depth", text_color=color.white, text_size=size.small)
    table.cell(debugTbl, 1, 3, str.tostring(pbDepth, "#.##"), text_color=color.yellow, text_size=size.small)
    table.cell(debugTbl, 0, 4, "React", text_color=color.white, text_size=size.small)
    table.cell(debugTbl, 1, 4, reactReasons, text_color=color.yellow, text_size=size.small)

// ── Alerts ──────────────────────────────────────────────────────────
alertcondition(state == 1 or state == -1, "Armed", "Phase58 ARMED")
alertcondition(state == 2 or state == -2, "Take", "Phase58 TAKE")
alertcondition(state == 3, "Exit", "Phase58 EXIT")

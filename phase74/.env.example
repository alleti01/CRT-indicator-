# Phase74 environment — copy to .env and fill values (never commit .env)

# Safety defaults (do not enable live routing without explicit review)
TRADING_ENABLED=false
SHADOW_MODE=true
EXTERNAL_ORDER_ROUTING=false

# NinjaTrader read-only bar bridge (localhost)
NINJATRADER_BRIDGE_TOKEN=change-me-to-a-long-random-secret
# Accept localhost bridge when NT AuthToken is blank/stale (shadow dev only)
NINJATRADER_BRIDGE_TRUST_LOCALHOST=true

# Phase74 webhook (Pine signal authority)
PHASE74_WEBHOOK_SECRET=change-me-to-a-long-random-secret

# Optional kill switch (1 = halt new entries)
PHASE74_KILL_SWITCH=0

# Legacy Databento (not used when provider=ninjatrader)
# DATABENTO_API_KEY=

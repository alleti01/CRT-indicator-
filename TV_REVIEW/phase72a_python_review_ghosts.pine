f_has(int t, int[] arr) =>
    bool hit = false
    for i = 0 to array.size(arr) - 1
        if array.get(arr, i) == t
            hit := true
            break
    hit

f_idx(int t, int[] arr) =>
    int ix = -1
    for i = 0 to array.size(arr) - 1
        if array.get(arr, i) == t
            ix := i
            break
    ix

if showGhosts and barstate.isconfirmed
    si = f_idx(time, SIG_MS)
    if si >= 0
        d = array.get(DIR, si) == 1 ? "LONG" : "SHORT"
        tid = showIds ? array.get(TID, si) : ""
        label.new(bar_index, high, "PY SIG " + d + "\n" + tid, style=label.style_label_down, color=color.new(color.fuchsia, 15), textcolor=color.white, size=size.small)
    ei = f_idx(time, ENT_MS)
    if ei >= 0
        d = array.get(DIR, ei) == 1 ? "LONG" : "SHORT"
        px = array.get(ENT_PX, ei)
        tid = showIds ? array.get(TID, ei) : ""
        y = d == "LONG" ? low : high
        label.new(bar_index, y, "PY ENTRY " + d + "\n" + str.tostring(px, format.mintick) + "\n" + tid, style=d == "LONG" ? label.style_label_up : label.style_label_down, color=color.new(color.yellow, 5), textcolor=color.black, size=size.normal)

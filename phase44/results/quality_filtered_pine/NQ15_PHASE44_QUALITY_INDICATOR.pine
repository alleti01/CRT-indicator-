//@version=6
// NQ 15m Combined — Phase 44 Quality Filter (Phase 40 + Phase 43 simple score)
// Phase 31 continuation frozen. Reversal uses concurrent candidate pool (Phase 37 parity).
// No repainting — barstate.isconfirmed only.

indicator(
     "NQ 15M Combined Phase 44 Quality Filter",
     shorttitle = "NQ15_P44",
     overlay = true,
     max_labels_count = 500,
     max_lines_count = 500)

bool tfOk = timeframe.period == "15"

// ═══ FROZEN CONSTANTS — DO NOT EXPOSE AS INPUTS ═══
const float FZ_BODY_MULT       = 1.5
const int   FZ_BODY_AVG_LEN    = 20
const float FZ_CL_LONG         = 0.80
const float FZ_CL_SHORT        = 0.20
const float FZ_BOS_RETEST_TOL  = 0.10
const int   FZ_BOS_RETEST_WIN  = 2
const int   FZ_ATR_LEN         = 14
const string FZ_RTH            = "0930-1600"
const int   FZ_DEDUPE_ACTIVE   = 6
const int   FZ_DEDUPE_SAME_DIR = 4
const int   FZ_DEDUPE_DAY_CAP  = 2
const float FZ_P31_STOP_ATR    = 0.75
const float FZ_P31_TARGET_R    = 3.0
const int   FZ_P31_MAX_HOLD    = 4
const int   FZ_P33_FAIL_WIN    = 4
const int   FZ_P33_RETEST_WIN  = 2
const float FZ_P33_STOP_ATR    = 0.75
const float FZ_P33_TARGET_R    = 2.5
const int   FZ_P33_MAX_HOLD    = 3
const int   FZ_RV_POOL_CAP     = 8

const float FZ_IMPULSE_MIN     = 0.65
const float FZ_Q_RAW_LO          = -0.00496580294121185
const float FZ_Q_RAW_HI          = 0.02060542475082916
const float FZ_Q_PASS_MIN        = 36.49346328963349
const float FZ_Q_TIER_APLUS      = 63.198239617422814
const float FZ_Q_TIER_A          = 46.076841180646284
const float FZ_Q_TIER_B          = 36.49346328963349

const int ST_IDLE = 0
const int ST_WAIT = 1
const int ST_ACTIVE = 2
const int RV_ST_RECLAIM = 1
const int RV_ST_RETEST = 2

type ReversalCand
    int state
    int dispDir
    int revDir
    float mid
    int dispBar
    int expiryBar
    int confirmBar
    float reclaim
    float tol
    int retestDeadline
    bool dedupeOk
    int candId
    int dispTime

type RvOpenTrade
    int dir
    float entry
    float stop
    float target
    int held
    int entryBar

string GRP = "Display"
bool showTfWarn = input.bool(true, "Show 15m warning", group = GRP)
bool showCont = input.bool(true, "Show Continuation Signals", group = GRP)
bool showRev = input.bool(true, "Show Reversal Signals", group = GRP)
bool showLevels = input.bool(true, "Show Trade Levels", group = GRP)
bool showHistoricalTradeLines = input.bool(true, "Show Historical Trade Lines", group = GRP)
int histLineLimit = input.int(3, "Historical line sets", minval = 0, maxval = 10, group = GRP)
bool showExitMarkers = input.bool(false, "Show Exit Markers", group = GRP)
bool showDebug = input.bool(false, "Show Debug", group = GRP)
bool showRejected = input.bool(false, "Show Impulse Rejected", group = GRP)
bool showQualityRejected = input.bool(false, "Show Quality Rejected", group = GRP)
bool showConfidence = input.bool(true, "Show Confidence Tier", group = GRP)
bool showPlacementDebug = input.bool(false, "Show Placement Debug", group = GRP)

inRth(string sess) =>
    int sh = int(str.tonumber(str.substring(sess, 0, 2)))
    int sm = int(str.tonumber(str.substring(sess, 2, 4)))
    int eh = int(str.tonumber(str.substring(sess, 5, 7)))
    int em = int(str.tonumber(str.substring(sess, 7, 9)))
    int startM = sh * 60 + sm
    int endM = eh * 60 + em
    int curM = hour * 60 + minute
    startM <= endM ? curM >= startM and curM < endM : curM >= startM or curM < endM

cmeDayKey() =>
    str.format("{0,number,0000}-{1,number,00}-{2,number,00}", year, month, dayofmonth)

dedupePass(int dir, int activeUntil, int lastLongBar, int lastShortBar, string dayKey, int dayCount) =>
    bool sameDirOk = dir == 1 ? bar_index - lastLongBar >= FZ_DEDUPE_SAME_DIR : bar_index - lastShortBar >= FZ_DEDUPE_SAME_DIR
    bool activeOk = bar_index > activeUntil
    string dk = cmeDayKey()
    bool dayOk = dk != dayKey ? true : dayCount < FZ_DEDUPE_DAY_CAP
    activeOk and sameDirOk and dayOk

tryBosRetestFill(int dir, float level, float tol) =>
    bool filled = false
    float px = na
    if dir == 1 and low <= level + tol
        px := math.min(level + tol, close)
        filled := true
    if dir == -1 and high >= level - tol
        px := math.max(level - tol, close)
        filled := true
    [filled, px]

midpointReclaimed(int dispDir, float mid) =>
    dispDir == -1 ? close > mid : close < mid

tryReclaimRetestFill(int dir, float level, float tol) =>
    bool filled = false
    float px = na
    if dir == 1 and low <= level + tol
        px := math.min(level + tol, close)
        filled := true
    if dir == -1 and high >= level - tol
        px := math.max(level - tol, close)
        filled := true
    [filled, px]

newReversalCand(int dispDir, float mid, int dBar, int cid) =>
    int rDir = dispDir == -1 ? 1 : -1
    ReversalCand.new(RV_ST_RECLAIM, dispDir, rDir, mid, dBar, dBar + FZ_P33_FAIL_WIN, -1, na, na, -1, false, cid, int(time))

float atrVal = ta.atr(FZ_ATR_LEN)
impulse3Bar() =>
    atrVal > 0 ? math.abs(close - close[3]) / atrVal : na

bool impulsePass = not na(impulse3Bar()) and impulse3Bar() >= FZ_IMPULSE_MIN

qualityRaw(int dir) =>
    float r1 = close[1] != 0 ? ((close - close[1]) / close[1]) * dir : 0.0
    float r2 = close[2] != 0 ? ((close - close[2]) / close[2]) * dir : 0.0
    float r3 = close[3] != 0 ? ((close - close[3]) / close[3]) * dir : 0.0
    r1 + r2 + r3

qualityScore(int dir) =>
    float raw = qualityRaw(dir)
    float span = FZ_Q_RAW_HI - FZ_Q_RAW_LO
    span > 0 ? math.max(0.0, math.min(100.0, (raw - FZ_Q_RAW_LO) / span * 100.0)) : 50.0

qualityPass(int dir) =>
    qualityScore(dir) >= FZ_Q_PASS_MIN

confidenceTier(int dir) =>
    float s = qualityScore(dir)
    s >= FZ_Q_TIER_APLUS ? "A+" : s >= FZ_Q_TIER_A ? "A" : s >= FZ_Q_TIER_B ? "B" : "C"
float barBody = math.abs(close - open)
float avgBody = ta.sma(barBody, FZ_BODY_AVG_LEN)
float barRange = high - low
float closeLoc = barRange > 0 ? (close - low) / barRange : na
bool rthOk = inRth(FZ_RTH)
bool bodyReady = bar_index >= FZ_BODY_AVG_LEN
bool longDisp = tfOk and rthOk and bodyReady and not na(avgBody) and barBody > FZ_BODY_MULT * avgBody and closeLoc >= FZ_CL_LONG
bool shortDisp = tfOk and rthOk and bodyReady and not na(avgBody) and barBody > FZ_BODY_MULT * avgBody and closeLoc <= FZ_CL_SHORT

priceLevelOk(float lvl, float anchor) =>
    not na(lvl) and not na(anchor) and not na(atrVal) and atrVal > 0 and math.abs(lvl - anchor) <= atrVal * 30.0

tradeLevelsOk(float entryPx, float stopPx, float targetPx) =>
    priceLevelOk(entryPx, close) and priceLevelOk(stopPx, entryPx) and priceLevelOk(targetPx, entryPx)

newLevelLine(int x1, float y1, int x2, float y2, color col, int transp) =>
    priceLevelOk(y1, close) ? line.new(x1, y1, x2, y2, xloc = xloc.bar_index, color = color.new(col, transp), width = 1) : na

deleteLine(line ln) =>
    if not na(ln)
        line.delete(ln)

archiveLines(line lnE, line lnS, line lnT, array<line> histE, array<line> histS, array<line> histT) =>
    if not na(lnE) and not na(lnS) and not na(lnT)
        line.set_x2(lnE, bar_index)
        line.set_x2(lnS, bar_index)
        line.set_x2(lnT, bar_index)
        if showHistoricalTradeLines and histLineLimit > 0
            array.push(histE, lnE)
            array.push(histS, lnS)
            array.push(histT, lnT)
            while array.size(histE) > histLineLimit
                deleteLine(array.shift(histE))
                deleteLine(array.shift(histS))
                deleteLine(array.shift(histT))
        else
            deleteLine(lnE)
            deleteLine(lnS)
            deleteLine(lnT)

extendLines(line lnE, line lnS, line lnT) =>
    if not na(lnE) and not na(lnS) and not na(lnT)
        line.set_x2(lnE, bar_index)
        line.set_x2(lnS, bar_index)
        line.set_x2(lnT, bar_index)

// ═══ PHASE 31 CONTINUATION STATE (FROZEN) ═══
var int   p31State = ST_IDLE
var int   p31Dir = 0
var float p31Bos = na
var float p31Tol = na
var int   p31DispBar = na
var int   p31Deadline = na
var float p31Entry = na
var float p31Stop = na
var float p31Target = na
var int   p31Held = 0
var int   p31DdActive = -1
var int   p31DdLong = -999
var int   p31DdShort = -999
var string p31DdDay = ""
var int   p31DdCount = 0
var int   p31EntryBar = na

// ═══ PHASE 33 CONCURRENT REVERSAL POOL ═══
var array<ReversalCand> rvPool = array.new<ReversalCand>()
var array<RvOpenTrade> rvOpen = array.new<RvOpenTrade>()
var int rvCandSeq = 0
var int rvDdActive = -1
var int rvDdLong = -999
var int rvDdShort = -999
var string rvDdDay = ""
var int rvDdCount = 0

// ═══ VISUALIZATION STATE ONLY ═══
var line  p31LnE = na
var line  p31LnS = na
var line  p31LnT = na
var line  rvLnE = na
var line  rvLnS = na
var line  rvLnT = na
var array<line> p31HistE = array.new_line()
var array<line> p31HistS = array.new_line()
var array<line> p31HistT = array.new_line()
var array<line> rvHistE = array.new_line()
var array<line> rvHistS = array.new_line()
var array<line> rvHistT = array.new_line()

var bool p31FillEvt = false
var bool p31RejectEvt = false
var bool p31QualRejectEvt = false
var int  p31RejectDir = 0
var int  p31QualRejectDir = 0
var string p31ConfTier = ""
float lastQualityScore = na
var bool rvFillLongEvt = false
var bool rvRejectLongEvt = false
var bool rvRejectShortEvt = false
var bool rvQualRejectLongEvt = false
var bool rvQualRejectShortEvt = false
var string rvConfTier = ""
var bool rvFillShortEvt = false
var int  p31FillDir = 0
var float rvFillEntry = na
var bool p31StopEvt = false
var bool p31TgtEvt = false
var bool p31TimeEvt = false
var bool rvStopEvt = false
var bool rvTgtEvt = false
var bool rvTimeEvt = false
var int  p31ExitDir = 0
var int  rvExitDir = 0

if barstate.isconfirmed and tfOk
    p31FillEvt := false
    p31RejectEvt := false
    p31QualRejectEvt := false
    p31RejectDir := 0
    p31QualRejectDir := 0
    p31ConfTier := ""
    rvQualRejectLongEvt := false
    rvQualRejectShortEvt := false
    rvConfTier := ""
    rvFillLongEvt := false
    rvRejectLongEvt := false
    rvRejectShortEvt := false
    rvFillShortEvt := false
    p31FillDir := 0
    rvFillEntry := na
    p31StopEvt := false
    p31TgtEvt := false
    p31TimeEvt := false
    rvStopEvt := false
    rvTgtEvt := false
    rvTimeEvt := false

    // ── Phase 31 trade management (unchanged) ──
    if p31State == ST_ACTIVE
        p31Held += 1
        bool hitStop = p31Dir == 1 ? low <= p31Stop : high >= p31Stop
        bool hitTgt = p31Dir == 1 ? high >= p31Target : low <= p31Target
        if hitStop
            p31StopEvt := true
            p31ExitDir := p31Dir
            if showLevels
                archiveLines(p31LnE, p31LnS, p31LnT, p31HistE, p31HistS, p31HistT)
            p31LnE := na
            p31LnS := na
            p31LnT := na
            p31State := ST_IDLE
            p31Dir := 0
        else if hitTgt
            p31TgtEvt := true
            p31ExitDir := p31Dir
            if showLevels
                archiveLines(p31LnE, p31LnS, p31LnT, p31HistE, p31HistS, p31HistT)
            p31LnE := na
            p31LnS := na
            p31LnT := na
            p31State := ST_IDLE
            p31Dir := 0
        else if p31Held >= FZ_P31_MAX_HOLD
            p31TimeEvt := true
            p31ExitDir := p31Dir
            if showLevels
                archiveLines(p31LnE, p31LnS, p31LnT, p31HistE, p31HistS, p31HistT)
            p31LnE := na
            p31LnS := na
            p31LnT := na
            p31State := ST_IDLE
            p31Dir := 0
        else if showLevels
            extendLines(p31LnE, p31LnS, p31LnT)

    else if p31State == ST_WAIT
        if bar_index > p31Deadline
            p31State := ST_IDLE
            p31Dir := 0
        else if bar_index > p31DispBar
            [filled, px] = tryBosRetestFill(p31Dir, p31Bos, p31Tol)
            if filled
                if impulsePass
                    if qualityPass(p31Dir)
                        p31Entry := px
                        float risk = FZ_P31_STOP_ATR * atrVal
                        p31Stop := p31Dir == 1 ? p31Entry - risk : p31Entry + risk
                        p31Target := p31Dir == 1 ? p31Entry + FZ_P31_TARGET_R * risk : p31Entry - FZ_P31_TARGET_R * risk
                        p31Held := 0
                        p31State := ST_ACTIVE
                        p31EntryBar := bar_index
                        p31FillEvt := true
                        p31FillDir := p31Dir
                        lastQualityScore := qualityScore(p31Dir)
                        p31ConfTier := confidenceTier(p31Dir)
                        if showLevels and tradeLevelsOk(p31Entry, p31Stop, p31Target)
                            deleteLine(p31LnE)
                            deleteLine(p31LnS)
                            deleteLine(p31LnT)
                            p31LnE := newLevelLine(p31EntryBar, p31Entry, bar_index, p31Entry, color.blue, 20)
                            p31LnS := newLevelLine(p31EntryBar, p31Stop, bar_index, p31Stop, color.red, 20)
                            p31LnT := newLevelLine(p31EntryBar, p31Target, bar_index, p31Target, color.lime, 20)
                    else
                        p31QualRejectEvt := true
                        p31QualRejectDir := p31Dir
                        p31State := ST_IDLE
                        p31Dir := 0
                else
                    p31RejectEvt := true
                    p31RejectDir := p31Dir
                    p31State := ST_IDLE
                    p31Dir := 0

    else if p31State == ST_IDLE
        string p31Dk = cmeDayKey()
        if p31Dk != p31DdDay
            p31DdDay := p31Dk
            p31DdCount := 0
        if longDisp and dedupePass(1, p31DdActive, p31DdLong, p31DdShort, p31DdDay, p31DdCount)
            p31Dir := 1
            p31Bos := high
            p31Tol := FZ_BOS_RETEST_TOL * atrVal
            p31DispBar := bar_index
            p31Deadline := bar_index + FZ_BOS_RETEST_WIN
            p31State := ST_WAIT
            p31DdActive := bar_index + FZ_DEDUPE_ACTIVE
            p31DdLong := bar_index
            if cmeDayKey() != p31DdDay
                p31DdDay := cmeDayKey()
                p31DdCount := 1
            else
                p31DdCount += 1
        else if shortDisp and dedupePass(-1, p31DdActive, p31DdLong, p31DdShort, p31DdDay, p31DdCount)
            p31Dir := -1
            p31Bos := low
            p31Tol := FZ_BOS_RETEST_TOL * atrVal
            p31DispBar := bar_index
            p31Deadline := bar_index + FZ_BOS_RETEST_WIN
            p31State := ST_WAIT
            p31DdActive := bar_index + FZ_DEDUPE_ACTIVE
            p31DdShort := bar_index
            if cmeDayKey() != p31DdDay
                p31DdDay := cmeDayKey()
                p31DdCount := 1
            else
                p31DdCount += 1

    // ── Reversal open-trade management (independent of candidate pool) ──
    if array.size(rvOpen) > 0
        for ti = array.size(rvOpen) - 1 to 0
            RvOpenTrade tr = array.get(rvOpen, ti)
            tr.held += 1
            bool trStop = tr.dir == 1 ? low <= tr.stop : high >= tr.stop
            bool trTgt = tr.dir == 1 ? high >= tr.target : low <= tr.target
            if trStop or trTgt or tr.held >= FZ_P33_MAX_HOLD
                rvStopEvt := trStop
                rvTgtEvt := trTgt
                rvTimeEvt := not trStop and not trTgt
                rvExitDir := tr.dir
                if showLevels and ti == array.size(rvOpen) - 1
                    archiveLines(rvLnE, rvLnS, rvLnT, rvHistE, rvHistS, rvHistT)
                    rvLnE := na
                    rvLnS := na
                    rvLnT := na
                array.remove(rvOpen, ti)
            else
                array.set(rvOpen, ti, tr)
        if showLevels and array.size(rvOpen) > 0 and not na(rvLnE)
            extendLines(rvLnE, rvLnS, rvLnT)

    // ── Create new reversal candidates (every displacement, no dedupe here) ──
    if longDisp and array.size(rvPool) < FZ_RV_POOL_CAP
        rvCandSeq += 1
        array.push(rvPool, newReversalCand(1, (high + low) / 2.0, bar_index, rvCandSeq))
    if shortDisp and array.size(rvPool) < FZ_RV_POOL_CAP
        rvCandSeq += 1
        array.push(rvPool, newReversalCand(-1, (high + low) / 2.0, bar_index, rvCandSeq))

    // ── Update concurrent reversal candidates ──
    string rvDk = cmeDayKey()
    if rvDk != rvDdDay
        rvDdDay := rvDk
        rvDdCount := 0

    array<ReversalCand> nextPool = array.new<ReversalCand>()
    array<int> reclaimIdx = array.new_int()
    array<int> reclaimDispBar = array.new_int()
    array<int> reclaimCandId = array.new_int()
    array<int> fireIdx = array.new_int()
    array<int> fireDispBar = array.new_int()
    array<int> fireCandId = array.new_int()
    array<float> firePx = array.new_float()
    array<float> fireStop = array.new_float()
    array<float> fireTarget = array.new_float()
    array<int> fireRevDir = array.new_int()

    if array.size(rvPool) > 0
        for ci = 0 to array.size(rvPool) - 1
            ReversalCand c = array.get(rvPool, ci)
            if c.state == RV_ST_RECLAIM
                if bar_index > c.expiryBar
                    continue
                if bar_index > c.dispBar and midpointReclaimed(c.dispDir, c.mid)
                    array.push(reclaimIdx, ci)
                    array.push(reclaimDispBar, c.dispBar)
                    array.push(reclaimCandId, c.candId)
                else
                    array.push(nextPool, c)
            else if c.state == RV_ST_RETEST and c.dedupeOk
                if bar_index > c.retestDeadline
                    continue
                if bar_index > c.confirmBar
                    [rvFill, rvPx] = tryReclaimRetestFill(c.revDir, c.reclaim, c.tol)
                    if rvFill
                        float rvRisk = FZ_P33_STOP_ATR * atrVal
                        float rvSt = c.revDir == 1 ? rvPx - rvRisk : rvPx + rvRisk
                        float rvTg = c.revDir == 1 ? rvPx + FZ_P33_TARGET_R * rvRisk : rvPx - FZ_P33_TARGET_R * rvRisk
                        array.push(fireIdx, ci)
                        array.push(fireDispBar, c.dispBar)
                        array.push(fireCandId, c.candId)
                        array.push(firePx, rvPx)
                        array.push(fireStop, rvSt)
                        array.push(fireTarget, rvTg)
                        array.push(fireRevDir, c.revDir)
                    else
                        array.push(nextPool, c)
                else
                    array.push(nextPool, c)

    // Process reclaims — dedupe at confirm bar (Phase 33 / Phase 37 semantics)
    int nReclaim = array.size(reclaimIdx)
    if nReclaim > 0
        for ri = 0 to nReclaim - 1
            int best = ri
            if ri + 1 <= nReclaim - 1
                for rj = ri + 1 to nReclaim - 1
                    int dbj = array.get(reclaimDispBar, rj)
                    int dbi = array.get(reclaimDispBar, best)
                    int idj = array.get(reclaimCandId, rj)
                    int idi = array.get(reclaimCandId, best)
                    if dbj < dbi or (dbj == dbi and idj < idi)
                        best := rj
            if best != ri
                int tIdx = array.get(reclaimIdx, ri)
                int tDb = array.get(reclaimDispBar, ri)
                int tId = array.get(reclaimCandId, ri)
                array.set(reclaimIdx, ri, array.get(reclaimIdx, best))
                array.set(reclaimDispBar, ri, array.get(reclaimDispBar, best))
                array.set(reclaimCandId, ri, array.get(reclaimCandId, best))
                array.set(reclaimIdx, best, tIdx)
                array.set(reclaimDispBar, best, tDb)
                array.set(reclaimCandId, best, tId)
            int ci = array.get(reclaimIdx, ri)
            ReversalCand c = array.get(rvPool, ci)
            bool dedupeOk = dedupePass(c.revDir, rvDdActive, rvDdLong, rvDdShort, rvDdDay, rvDdCount)
            if dedupeOk
                rvDdActive := bar_index + FZ_DEDUPE_ACTIVE
                if c.revDir == 1
                    rvDdLong := bar_index
                else
                    rvDdShort := bar_index
                if cmeDayKey() != rvDdDay
                    rvDdDay := cmeDayKey()
                    rvDdCount := 1
                else
                    rvDdCount += 1
                c.confirmBar := bar_index
                c.reclaim := c.mid
                c.tol := FZ_BOS_RETEST_TOL * atrVal
                c.retestDeadline := bar_index + FZ_P33_RETEST_WIN
                c.dedupeOk := true
                c.state := RV_ST_RETEST
                array.push(nextPool, c)

    rvPool := nextPool

    // Emit fills — at most one RL and one RS per bar (earliest displacement wins)
    bool seenRl = false
    bool seenRs = false
    int nFire = array.size(fireIdx)
    if nFire > 0
        for fi = 0 to nFire - 1
            int best = fi
            if fi + 1 <= nFire - 1
                for fj = fi + 1 to nFire - 1
                    int dbj = array.get(fireDispBar, fj)
                    int dbi = array.get(fireDispBar, best)
                    int idj = array.get(fireCandId, fj)
                    int idi = array.get(fireCandId, best)
                    if dbj < dbi or (dbj == dbi and idj < idi)
                        best := fj
            if best != fi
                int tI = array.get(fireIdx, fi)
                int tD = array.get(fireDispBar, fi)
                int tC = array.get(fireCandId, fi)
                float tP = array.get(firePx, fi)
                float tS = array.get(fireStop, fi)
                float tT = array.get(fireTarget, fi)
                int tR = array.get(fireRevDir, fi)
                array.set(fireIdx, fi, array.get(fireIdx, best))
                array.set(fireDispBar, fi, array.get(fireDispBar, best))
                array.set(fireCandId, fi, array.get(fireCandId, best))
                array.set(firePx, fi, array.get(firePx, best))
                array.set(fireStop, fi, array.get(fireStop, best))
                array.set(fireTarget, fi, array.get(fireTarget, best))
                array.set(fireRevDir, fi, array.get(fireRevDir, best))
                array.set(fireIdx, best, tI)
                array.set(fireDispBar, best, tD)
                array.set(fireCandId, best, tC)
                array.set(firePx, best, tP)
                array.set(fireStop, best, tS)
                array.set(fireTarget, best, tT)
                array.set(fireRevDir, best, tR)
            int rDir = array.get(fireRevDir, fi)
            if rDir == 1 and seenRl
                continue
            if rDir == -1 and seenRs
                continue
            float px = array.get(firePx, fi)
            float st = array.get(fireStop, fi)
            float tg = array.get(fireTarget, fi)
            if impulsePass
                if qualityPass(rDir)
                    if rDir == 1
                        seenRl := true
                        rvFillLongEvt := true
                    else
                        seenRs := true
                        rvFillShortEvt := true
                    rvFillEntry := px
                    lastQualityScore := qualityScore(rDir)
                    rvConfTier := confidenceTier(rDir)
                    array.push(rvOpen, RvOpenTrade.new(rDir, px, st, tg, 0, bar_index))
                    if showLevels and tradeLevelsOk(px, st, tg)
                        deleteLine(rvLnE)
                        deleteLine(rvLnS)
                        deleteLine(rvLnT)
                        rvLnE := newLevelLine(bar_index, px, bar_index, px, color.teal, 30)
                        rvLnS := newLevelLine(bar_index, st, bar_index, st, color.red, 30)
                        rvLnT := newLevelLine(bar_index, tg, bar_index, tg, color.orange, 30)
                else
                    if rDir == 1
                        rvQualRejectLongEvt := true
                    else
                        rvQualRejectShortEvt := true
            else
                if rDir == 1
                    rvRejectLongEvt := true
                else
                    rvRejectShortEvt := true

// ═══ VISUALIZATION OUTPUTS — tiny bar-anchored markers ═══


plotshape(showQualityRejected and barstate.isconfirmed and p31QualRejectEvt and p31QualRejectDir == 1, "Quality Rejected Long", shape.cross, location.belowbar, color.new(color.orange, 20), size = size.tiny, text = "C")
plotshape(showQualityRejected and barstate.isconfirmed and p31QualRejectEvt and p31QualRejectDir == -1, "Quality Rejected Short", shape.cross, location.abovebar, color.new(color.orange, 20), size = size.tiny, text = "C")
plotshape(showQualityRejected and barstate.isconfirmed and rvQualRejectLongEvt, "Quality Rejected RL", shape.cross, location.belowbar, color.new(color.orange, 30), size = size.tiny, text = "C")
plotshape(showQualityRejected and barstate.isconfirmed and rvQualRejectShortEvt, "Quality Rejected RS", shape.cross, location.abovebar, color.new(color.orange, 30), size = size.tiny, text = "C")

plotshape(showRejected and barstate.isconfirmed and p31RejectEvt and p31RejectDir == 1, "Rejected Long", shape.cross, location.belowbar, color.new(color.gray, 30), size = size.tiny, text = "xL")
plotshape(showRejected and barstate.isconfirmed and p31RejectEvt and p31RejectDir == -1, "Rejected Short", shape.cross, location.abovebar, color.new(color.gray, 30), size = size.tiny, text = "xS")
plotshape(showRejected and barstate.isconfirmed and rvRejectLongEvt, "Rejected RL", shape.cross, location.belowbar, color.new(color.gray, 40), size = size.tiny, text = "xRL")
plotshape(showRejected and barstate.isconfirmed and rvRejectShortEvt, "Rejected RS", shape.cross, location.abovebar, color.new(color.gray, 40), size = size.tiny, text = "xRS")

plotshape(showCont and barstate.isconfirmed and p31FillEvt and p31FillDir == 1, "Continuation Long", shape.triangleup, location.belowbar, color.new(color.lime, 0), size = size.tiny, text = "L")
plotshape(showCont and barstate.isconfirmed and p31FillEvt and p31FillDir == -1, "Continuation Short", shape.triangledown, location.abovebar, color.new(color.red, 0), size = size.tiny, text = "S")
plotshape(showRev and barstate.isconfirmed and rvFillLongEvt, "Reversal Long", shape.triangleup, location.belowbar, color.new(color.teal, 0), size = size.tiny, text = "RL")
plotshape(showRev and barstate.isconfirmed and rvFillShortEvt, "Reversal Short", shape.triangledown, location.abovebar, color.new(color.orange, 0), size = size.tiny, text = "RS")

if showExitMarkers and barstate.isconfirmed
    if p31StopEvt or p31TgtEvt or p31TimeEvt
        label.new(bar_index, p31ExitDir == 1 ? low : high, "X", style = p31ExitDir == 1 ? label.style_label_up : label.style_label_down, xloc = xloc.bar_index, yloc = yloc.price, color = color.new(color.gray, 50), textcolor = color.white, size = size.tiny)
    if rvStopEvt or rvTgtEvt or rvTimeEvt
        label.new(bar_index, rvExitDir == 1 ? low : high, "X", style = rvExitDir == 1 ? label.style_label_up : label.style_label_down, xloc = xloc.bar_index, yloc = yloc.price, color = color.new(color.gray, 70), textcolor = color.white, size = size.tiny)

plotshape(showDebug and barstate.isconfirmed and longDisp, "Dbg Disp+", shape.circle, location.belowbar, color.new(color.gray, 60), size = size.tiny, text = "d")
plotshape(showDebug and barstate.isconfirmed and shortDisp, "Dbg Disp-", shape.circle, location.abovebar, color.new(color.gray, 60), size = size.tiny, text = "d")
plotshape(showDebug and barstate.isconfirmed and array.size(rvPool) > 1, "Dbg MultiCand", shape.diamond, location.top, color.new(color.yellow, 50), size = size.tiny, text = "M")

if showPlacementDebug and barstate.isconfirmed
    if p31FillEvt
        string p31Tag = p31FillDir == 1 ? "L" : "S"
        label.new(bar_index, p31FillDir == 1 ? low : high, p31Tag + "\n" + str.tostring(bar_index) + "\n" + str.tostring(p31Entry, "#.##"), style = p31FillDir == 1 ? label.style_label_up : label.style_label_down, xloc = xloc.bar_index, yloc = yloc.price, color = color.new(color.black, 40), textcolor = color.white, size = size.tiny)
    if rvFillLongEvt or rvFillShortEvt
        string rvTag = rvFillLongEvt ? "RL" : "RS"
        label.new(bar_index, rvFillLongEvt ? low : high, rvTag + "\n" + str.tostring(bar_index) + "\n" + str.tostring(rvFillEntry, "#.##"), style = rvFillLongEvt ? label.style_label_up : label.style_label_down, xloc = xloc.bar_index, yloc = yloc.price, color = color.new(color.black, 60), textcolor = color.white, size = size.tiny)

plot(showPlacementDebug and p31FillEvt ? p31Entry : na, "P31 Entry Px Dot", color = color.new(color.lime, 0), style = plot.style_circles, linewidth = 2)
plot(showPlacementDebug and (rvFillLongEvt or rvFillShortEvt) ? rvFillEntry : na, "RV Entry Px Dot", color = color.new(color.teal, 0), style = plot.style_circles, linewidth = 2)

if showTfWarn and not tfOk and barstate.islast
    label.new(bar_index, high, "Use 15m · America/Chicago", style = label.style_label_down, xloc = xloc.bar_index, yloc = yloc.price, color = color.red, textcolor = color.white, size = size.small)

// ═══ ALERTS — entry fill events ═══
alertcondition(p31FillEvt and p31FillDir == 1, "CONTINUATION LONG", "NQ 15M — LONG")
alertcondition(p31FillEvt and p31FillDir == -1, "CONTINUATION SHORT", "NQ 15M — SHORT")
alertcondition(rvFillLongEvt, "REVERSAL LONG", "NQ 15M — REVERSAL LONG")
alertcondition(rvFillShortEvt, "REVERSAL SHORT", "NQ 15M — REVERSAL SHORT")
alertcondition(showRejected and p31RejectEvt, "DEBUG REJECTED CONT", "NQ 15M — REJECTED CONT")
alertcondition(showRejected and (rvRejectLongEvt or rvRejectShortEvt), "DEBUG REJECTED REV", "NQ 15M — REJECTED REV")
alertcondition(p31StopEvt, "PHASE31 STOP", "NQ 15M — PHASE31 STOP")
alertcondition(p31TgtEvt, "PHASE31 TARGET", "NQ 15M — PHASE31 TARGET")
alertcondition(p31TimeEvt, "PHASE31 TIME EXIT", "NQ 15M — PHASE31 TIME EXIT")
alertcondition(rvStopEvt, "PHASE33 STOP", "NQ 15M — PHASE33 STOP")
alertcondition(rvTgtEvt, "PHASE33 TARGET", "NQ 15M — PHASE33 TARGET")
alertcondition(rvTimeEvt, "PHASE33 TIME EXIT", "NQ 15M — PHASE33 TIME EXIT")

